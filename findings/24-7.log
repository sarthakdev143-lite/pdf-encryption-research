  m = re.search(rb"11 0 obj\s*<<([^>]*)>>stream(.*?)endstream", data, re.S)
  assert b"/Type/Metadata" in m.group(1)
  assert "META-CANARY control_plain" in m.group(2).decode("latin-1")  # LEAK: no password used
