"""Cycle 22: Track 2 hybrid /XRefStm vs trailer CONFLICTING /Encrypt.

Rev appends injected plaintext page; xref-stream dict carries DONOR
empty-password /Encrypt (attacker dict, obj n+4); classic trailer carries the
ORIGINAL /Encrypt ref + /Prev <orig> + /XRefStm <xs_off>. Minimal delta vs
prevchain h_refstm_encrypt (xs=orig-ref, trailer=absent) and h_trailer_encrypt
(trailer=orig-ref, xs=absent): here BOTH name /Encrypt with DIFFERENT values.
Tests which container wins when they conflict. 2 seeds x 6 engines."""
import json, re, sys
sys.path.insert(0, "/home/sarthak/pdf-encryption-research")
from pathlib import Path
from prevchain import (Seed, add_objects, add_classic_xref, add_xref_stream,
                       last_startxref, page_objects, donor_empty_pw_encrypt)
from triage import EXTRACTORS, run_batch

ROOT = Path("/home/sarthak/pdf-encryption-research")
OUT = Path("/tmp/opencode/cycle22_xrefstm_conflict")
OUT.mkdir(parents=True, exist_ok=True)
VARIANT = "h_conflict_trailerOrig_xsDonor"

results = {}
for seed_name in ["aes256_r6__plain.pdf", "rc4_128_r4__plain.pdf"]:
    seed = Seed(seed_name)
    assert seed.encrypt is not None
    canary = f"INJECTED {seed.stem} {VARIANT} ALPHA"
    buf = bytearray(seed.data)
    prev = last_startxref(seed.data)
    n = seed.size
    size = n + 12
    enc_ref = b"/Encrypt %d 0 R" % seed.encrypt
    objs = page_objects(n, canary, b"%d 0 R" % (n + 3))
    offs = add_objects(buf, objs)
    donor = donor_empty_pw_encrypt()
    offs.update(add_objects(buf, {n + 4: donor}))
    xs_num = n + 5
    xs_extra = b"/Encrypt %d 0 R" % (n + 4) + b" /Root %d 0 R" % n
    xs_off = add_xref_stream(buf, offs, xs_num, xs_extra, size)
    trailer_extra = enc_ref + b" /Root %d 0 R /Prev %d /XRefStm %d" % (n, prev, xs_off)
    xref = add_classic_xref(buf, offs, trailer_extra, size)
    path = OUT / f"{seed.stem}__{VARIANT}.pdf"
    path.write_bytes(bytes(buf))
    data = bytes(buf)
    # structure verification: both containers name /Encrypt with different refs
    assert data.count(b"/XRefStm") >= 1, "missing /XRefStm"
    tail = data[xref:xref + 3000]
    assert b"/Encrypt %d 0 R" % seed.encrypt in tail, "trailer must keep orig ref"
    assert b"/XRefStm %d" % xs_off in tail, "trailer must point at xs"
    assert (b"/Encrypt %d 0 R" % (n + 4)) in data, "donor ref missing"
    results[seed_name] = {"file": str(path), "injected": [canary], "original": seed.canaries}

paths = [v["file"] for v in results.values()]
rows = []
for engine in EXTRACTORS:
    res, failure = run_batch(engine, paths, 300)
    for seed_name, v in results.items():
        r = {"status": "CRASH", "text": "", "error": failure} if res is None else res[v["file"]]
        text = r.get("text") or ""
        norm = re.sub(r"\s+", "", text)
        rows.append({
            "seed": seed_name, "engine": engine, "status": r["status"],
            "injected": any(re.sub(r"\s+", "", x) in norm for x in v["injected"]),
            "original": any(re.sub(r"\s+", "", x) in norm for x in v["original"]),
            "detail": (r.get("error") or r.get("noise") or "")[:160],
        })
for r in rows:
    print(f"{r['seed']} {r['engine']:12} {r['status']:8} inj={int(r['injected'])} orig={int(r['original'])} {r['detail']}")
oi = sum(1 for r in rows if r["injected"])
oo = sum(1 for r in rows if r["original"])
print(f"TOTAL INJECTED {oi}/{len(rows)} ORIGINAL {oo}/{len(rows)}")
(OUT / "results.json").write_text(json.dumps(rows, indent=1))
