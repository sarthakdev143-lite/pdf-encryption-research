[0m$ [0m.venv/bin/python - <<'EOF'
# Track 4 scoping: no-password triage on writer-diversity files only (10 files x 6 engines)
import json, re, pathlib
from triage import EXTRACTORS, run_batch
ROOT = pathlib.Path(".").resolve()
man = json.load(open("corpus/manifest.json"))
wanted = [e for e in man if e["id"].startswith("w_")]
paths = [str(ROOT / e["file"]) for e in wanted if pathlib.Path(ROOT / e["file"]).exists()]
print(f"writer files present: {len(paths)}")
canmap = {str(ROOT / e["file"]): e.get("canaries", []) for e in wanted}
rows = []
for engine in EXTRACTORS:
    results, failure = run_batch(engine, paths, 120)
    for p in paths:
        res = {"status":"CRASH","text":"","error":failure} if results is None else results[p]
        text = res.get("text") or ""
        norm = re.sub(r"\s+","",text)
        hit = any(re.sub(r"\s+","",c) in norm for c in canmap[p])
        rows.append((pathlib.Path(p).name, engine, res["status"], hit, (res.get("error") or res.get("noise") or "")[:80]))
        if hit: print("LEAK!", p, engine, text[:200])
leak = [r for r in rows if r[3]]
print(f"probes={len(rows)} leaks={len(leak)}")
from collections import Counter
print(Counter(r[2] for r in rows))
EOF
