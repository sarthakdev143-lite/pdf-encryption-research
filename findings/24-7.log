"""Cycle 24: Track 2 /Size-shrink truncation game (fresh axis).

Rev appends an injected plaintext page exactly like prevchain `t_none`
(new Catalog/Pages/Page/Contents n..n+3, trailer /Root N 0 R /Prev <orig>,
NO /Encrypt) BUT the appended trailer declares /Size = seed.size (the
ORIGINAL size, excluding the 4 appended objects) instead of n+12.
Tests whether any engine honors /Size for object-table sizing (hiding the
injected page, refusing, or crashing) vs ignoring it, and critically
whether ORIGINAL encrypted content ever leaks. 2 seeds x 6 engines.
"""
import json, re, sys
sys.path.insert(0, "/home/sarthak/pdf-encryption-research")
from pathlib import Path
from prevchain import (Seed, add_objects, add_classic_xref,
                       last_startxref, page_objects)
from triage import EXTRACTORS, run_batch

ROOT = Path("/home/sarthak/pdf-encryption-research")
OUT = Path("/tmp/opencode/cycle24_size_shrink")
OUT.mkdir(parents=True, exist_ok=True)
VARIANT = "t_size_shrink"

results = {}
for seed_name in ["aes256_r6__plain.pdf", "rc4_128_r4__plain.pdf"]:
    seed = Seed(seed_name)
    assert seed.encrypt is not None
    canary = f"INJECTED {seed.stem} {VARIANT} ALPHA"
    buf = bytearray(seed.data)
    prev = last_startxref(seed.data)
    n = seed.size
    shrunk = seed.size  # DELIBERATE: excludes appended objects n..n+3
    assert shrunk < n + 4
    objs = page_objects(n, canary, b"%d 0 R" % (n + 3))
    offs = add_objects(buf, objs)
    xref = add_classic_xref(buf, offs, b" /Root %d 0 R /Prev %d" % (n, prev), shrunk)
    path = OUT / f"{seed.stem}__{VARIANT}.pdf"
    path.write_bytes(bytes(buf))
    data = bytes(buf)
    tail = data[xref:xref + 3000]
    assert (b"/Size %d" % shrunk) in tail, "appended trailer must carry shrunk /Size"
    assert b"/Encrypt" not in tail, "trailer must drop /Encrypt (t_none-like)"
    assert (b"%d 0 R" % n) in tail, "trailer Root must point at new catalog"
    assert b"/Prev %d" % prev in tail, "trailer must chain /Prev"
    # xref subsection still lists the new objects even though /Size excludes them
    assert (b"%d 4" % n) in data or (b"\n%d 4\n" % n) in data, "xref must still declare new objs"
    results[seed_name] = {"file": str(path), "injected": [canary], "original": seed.canaries}

paths = [v["file"] for v in results.values()]
rows = []
for engine in EXTRACTORS:
    res, failure = run_batch(engine, paths, 300)
    for seed_name, v in results.items():
        r = {"status": "CRASH", "text": "", "error": failure} if res is None else res[v["file"]]
        text = r.get("text") or ""
        norm = re.sub(r"\s+", "", text)
        rows.append({
            "seed": seed_name, "engine": engine, "status": r["status"],
            "injected": any(re.sub(r"\s+", "", x) in norm for x in v["injected"]),
            "original": any(re.sub(r"\s+", "", x) in norm for x in v["original"]),
            "detail": (r.get("error") or r.get("noise") or "")[:160],
        })
for r in rows:
    print(f"{r['seed']} {r['engine']:12} {r['status']:8} inj={int(r['injected'])} orig={int(r['original'])} {r['detail']}")
oi = sum(1 for r in rows if r["injected"])
oo = sum(1 for r in rows if r["original"])
print(f"TOTAL INJECTED {oi}/{len(rows)} ORIGINAL {oo}/{len(rows)}")
(OUT / "results.json").write_text(json.dumps(rows, indent=1))
