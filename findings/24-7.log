"""Cycle 32: Track 2 O/U-EMPTY probe.

NEW variant t_encrypt_stdV4R4POUempty: cycle-10 hostile dict shape
(/Filter/Standard /V 4 /R 4 /P -4) but O/U EMPTY hex strings (/O <> /U <>)
instead of 32 zero bytes. Direct-in-trailer dict on an appended revision
with the injected plaintext page. Tests whether any stack treats empty O/U
as absent, divides by zero-length, or falls back to plaintext. 2 seeds x 6
engines, no-password. Not in prevchain VARIANTS.
"""
import re, json, sys
from pathlib import Path

ROOT = Path("/home/sarthak/pdf-encryption-research")
sys.path.insert(0, str(ROOT))
from prevchain import Seed, page_objects, add_objects, add_classic_xref, last_startxref
from triage import EXTRACTORS, run_batch

OUTDIR = Path("/tmp/opencode/cycle32_ouempty")
OUTDIR.mkdir(parents=True, exist_ok=True)

SEEDS = ["aes256_r6__plain.pdf", "rc4_128_r4__plain.pdf"]
ENCRYPT = b"<< /Filter /Standard /V 4 /R 4 /P -4 /O <> /U <> >>"

results = {}
for name in SEEDS:
    seed = Seed(name)
    canary = f"INJECTED {seed.stem} t_ouempty ALPHA"
    buf = bytearray(seed.data)
    orig_len = len(seed.data)
    prev = last_startxref(seed.data)
    n = seed.size
    objs = page_objects(n, canary, b"%d 0 R" % (n + 3))
    offs = add_objects(buf, objs)
    extra = b"/Encrypt " + ENCRYPT + b" /Root %d 0 R /Prev %d" % (n, prev)
    add_classic_xref(buf, offs, extra, n + 12)
    assert bytes(buf[:orig_len]) == seed.data, "not pure-append!"
    out = OUTDIR / f"{seed.stem}__t_ouempty.pdf"
    out.write_bytes(bytes(buf))
    results[name] = {
        "file": str(out),
        "injected": [canary],
        "original": seed.canaries,
        "pure_append": True,
    }
    print(f"[ok] {out.name} size={out.stat().st_size} orig={orig_len}")

paths = [v["file"] for v in results.values()]
allrows = []
for engine in EXTRACTORS:
    res, failure = run_batch(engine, paths, 300)
    for name, v in results.items():
        r = {"status": "CRASH", "text": "", "error": str(failure)} if res is None else res[v["file"]]
        text = r.get("text") or ""
        norm = re.sub(r"\s+", "", text)
        inj = any(re.sub(r"\s+", "", x) in norm for x in v["injected"])
        orig = any(re.sub(r"\s+", "", x) in norm for x in v["original"])
