"""Cycle 6 Track 2: t_encrypt_stdV1 — appended revision, trailer /Encrypt << /Filter /Standard /V 1 >>
(dict-typed, Standard filter, explicit V=1, still missing O/U/P/R/Length), 2 seeds x 6 engines."""
import json, re, sys
from pathlib import Path
sys.path.insert(0, "/home/sarthak/pdf-encryption-research")
from triage import EXTRACTORS, run_batch

ROOT = Path("/home/sarthak/pdf-encryption-research")
BASE = ROOT / "corpus" / "base"
OUT = Path("/tmp/opencode/cycle6_stdV1")
OUT.mkdir(parents=True, exist_ok=True)
VARIANT = "t_encrypt_stdV1"
SEEDS = ["aes256_r6__plain.pdf", "rc4_128_r4__plain.pdf"]

def last_startxref(data: bytes) -> int:
    m = None
    for m in re.finditer(rb"startxref\s+(\d+)\s+%%EOF", data):
        pass
    return int(m.group(1))

def max_size(data: bytes) -> int:
    return max(int(x) for x in re.findall(rb"/Size\s+(\d+)", data))

def page_objects(n, canary):
    content = f"BT /F1 12 Tf 72 700 Td ({canary}) Tj ET".encode("latin-1")
    return {
        n: b"<< /Type /Catalog /Pages %d 0 R >>" % (n + 1),
        n + 1: b"<< /Type /Pages /Kids [%d 0 R] /Count 1 >>" % (n + 2),
        n + 2: (b"<< /Type /Page /Parent %d 0 R /MediaBox [0 0 612 792] "
                b"/Resources << /Font << /F1 << /Type /Font /Subtype /Type1 "
                b"/BaseFont /Helvetica >> >> >> /Contents %d 0 R >>" % (n + 1, n + 3)),
        n + 3: b"<< /Length %d >>\nstream\n" % len(content) + content + b"\nendstream",
    }

files, expected = [], {}
for name in SEEDS:
    stem = Path(name).stem
    data = (BASE / name).read_bytes()
    buf = bytearray(data)
    prev = last_startxref(data)
    n = max_size(data)
    size = n + 12
    canary = f"INJECTED {stem} {VARIANT} ALPHA"
    objs = page_objects(n, canary)
    if not buf.endswith(b"\n"):
        buf += b"\n"
    offs = {}
    for num in sorted(objs):
        offs[num] = len(buf)
        buf += b"%d 0 obj\n" % num + objs[num] + b"\nendobj\n"
    xref_off = len(buf)
    nums = sorted(offs)
    buf += b"xref\n0 1\n0000000000 65535 f \n"
    buf += b"%d %d\n" % (nums[0], len(nums))
    for num in nums:
        buf += b"%010d 00000 n \n" % offs[num]
    buf += (b"trailer\n<< /Size %d /Encrypt <</Filter/Standard /V 1>> "
            b"/Root %d 0 R /Prev %d >>\nstartxref\n%d\n%%%%EOF\n" % (size, n, prev, xref_off))
    out = OUT / f"{stem}__{VARIANT}.pdf"
    out.write_bytes(bytes(buf))
    files.append(str(out))
    expected[str(out)] = {"injected": canary,
                           "original": [f"CANARY {stem} ALPHA", f"CANARY {stem} BRAVO"]}
    print(f"[ok] {out.name} ({len(buf)} bytes)")

results = {}
for engine in EXTRACTORS:
    res, failure = run_batch(engine, files, 120)
    if res is None:
        results[engine] = {f: {"status": "CRASH", "error": str(failure), "text": ""} for f in files}
        print(f"{engine}: BATCH CRASH {failure}")
    else:
        results[engine] = res
        print(f"{engine}: {len(files)} probed")

def norm(s): return re.sub(r"\s+", "", s or "")
rows = []
for f in files:
    for engine in EXTRACTORS:
        r = results[engine][f]
        text = norm(r.get("text"))
        inj = norm(expected[f]["injected"]) in text
        orig = any(norm(c) in text for c in expected[f]["original"])
        rows.append({"file": Path(f).name, "engine": engine, "status": r.get("status"),
                     "injected": inj, "original": orig,
                     "detail": (r.get("error") or r.get("noise") or "")[:160]})
        print(f"{Path(f).name} {engine}: status={r.get('status')} injected={inj} ORIGINAL={orig} detail={(r.get('error') or r.get('noise') or '')[:100]}")
(OUT / "results.json").write_text(json.dumps(rows, indent=1))
o = sum(1 for r in rows if r["original"]); i = sum(1 for r in rows if r["injected"])
c = sum(1 for r in rows if r["status"] in ("CRASH", "TIMEOUT"))
print(f"SUMMARY probes={len(rows)} ORIGINAL={o} injected={i} crash/timeout={c}")
