"""Cycle 19: Track 2 both-encrypted hybrid cross-format chain — rev A classic WITH
/Encrypt, rev B xref-stream WITH /Encrypt (/Prev -> rev A). Tests whether any
latest-trailer-only stack stumbles on an xref-stream /Encrypt (final encrypted).
2 seeds x 6 engines."""
import json, re, sys
sys.path.insert(0, "/home/sarthak/pdf-encryption-research")
from pathlib import Path
from prevchain import Seed, page_objects, add_objects, add_classic_xref, add_xref_stream, last_startxref, pad_newline
from triage import EXTRACTORS, run_batch

ROOT = Path("/home/sarthak/pdf-encryption-research")
OUT = Path("/tmp/opencode/cycle19_classicxsenc")
OUT.mkdir(parents=True, exist_ok=True)
VARIANT = "chain_classicEncrypt_xsEncrypt"

results = {}
for seed_name in ["aes256_r6__plain.pdf", "rc4_128_r4__plain.pdf"]:
    seed = Seed(seed_name)
    canary = f"INJECTED {seed.stem} {VARIANT} ALPHA"
    buf = bytearray(seed.data)
    prev = last_startxref(seed.data)
    n = seed.size
    size = n + 12
    enc_ref = b"/Encrypt %d 0 R" % seed.encrypt
    objs = page_objects(n, canary, b"%d 0 R" % (n + 3))
    offs = add_objects(buf, objs)
    # rev A: classic trailer restoring original /Encrypt
    xref_a = add_classic_xref(buf, offs, enc_ref + b" /Root %d 0 R /Prev %d" % (n, prev), size)
    # rev B: xref-stream update KEEPING /Encrypt, /Prev -> rev A classic offset
    xs_num = n + 4
    xs_off = add_xref_stream(buf, {}, xs_num, enc_ref + b" /Root %d 0 R /Prev %d" % (n, xref_a), size)
    pad_newline(buf)
    buf += b"startxref\n%d\n%%%%EOF\n" % xs_off
    path = OUT / f"{seed.stem}__{VARIANT}.pdf"
    path.write_bytes(bytes(buf))
    # structural verification
    data = bytes(buf)
    sxs = [m.start() for m in re.finditer(rb"startxref", data)]
    assert len(sxs) == 3, f"expected 3 startxrefs, got {len(sxs)}: {seed_name}"
    m = re.search(rb"(\d+)\s+0\s+obj\s*\n<< /Type /XRef", data)
    assert m, "no xref-stream object found"
    tail = data[xs_off:xs_off+2000]
    assert b"/Encrypt" in tail, "final xs dict missing /Encrypt"
    assert b"/Prev" in tail, "final xs dict missing /Prev"
    results[seed_name] = {"file": str(path), "injected": [canary], "original": seed.canaries}

paths = [v["file"] for v in results.values()]
rows = []
for engine in EXTRACTORS:
    res, failure = run_batch(engine, paths, 300)
    for seed_name, v in results.items():
        r = {"status": "CRASH", "text": "", "error": failure} if res is None else res[v["file"]]
        text = r.get("text") or ""
        norm = re.sub(r"\s+", "", text)
        rows.append({
            "seed": seed_name, "engine": engine, "status": r["status"],
            "injected": any(re.sub(r"\s+", "", x) in norm for x in v["injected"]),
            "original": any(re.sub(r"\s+", "", x) in norm for x in v["original"]),
            "detail": (r.get("error") or r.get("noise") or "")[:160],
        })
for r in rows:
    print(f"{r['seed']} {r['engine']:12} {r['status']:8} inj={int(r['injected'])} orig={int(r['original'])} {r['detail']}")
orig = sum(1 for r in rows if r["original"])
inj = sum(1 for r in rows if r["injected"])
print(f"TOTAL ORIGINAL {orig}/{len(rows)} injected {inj}/{len(rows)}")
(OUT / "results.json").write_text(json.dumps(rows, indent=1))
