"""Cycle 43: Track 2 V5-StmF-dangle-StrF-valid mirror split micro-step.
Minimal delta vs cycles 33/41/42: keep O/U/OE/UE/Perms zeroed and
CF/DefaultCryptFilter AESV3 valid, but /StmF /NoSuchFilter (dangling) +
/StrF /DefaultCryptFilter (valid) - mirror of cycle 42 (StmF valid +
StrF dangling). Fresh axis: does dangling-StmF gate differ from
dangling-StrF gate (cycle 42 pypdf identical / pdfminer distinct)?
2 seeds x 6 engines = 12 no-password probes.
"""
import json, re, sys
from pathlib import Path
ROOT = Path("/home/sarthak/pdf-encryption-research")
sys.path.insert(0, str(ROOT))
from prevchain import Seed, page_objects, add_objects, add_classic_xref, last_startxref
from triage import EXTRACTORS, run_batch
OUT = Path("/tmp/opencode/cycle43_stmfmirror")
OUT.mkdir(parents=True, exist_ok=True)
ZERO32 = "00" * 32
ZERO16 = "00" * 16
HOSTILE = (
    b"<< /Filter /Standard /V 5 /R 6 /Length 256 /P -4 "
    b"/O <" + ZERO32.encode() + b"> /U <" + ZERO32.encode() + b"> "
    b"/OE <" + ZERO32.encode() + b"> /UE <" + ZERO32.encode() + b"> "
    b"/Perms <" + ZERO16.encode() + b"> "
    b"/CF <</DefaultCryptFilter <</AuthEvent /DocOpen /CFM /AESV3 /Length 32>> >> "
    b"/StmF /NoSuchFilter /StrF /DefaultCryptFilter >>"
)
def build(seed_name):
    seed = Seed(seed_name)
    variant = "t_encrypt_stdV5R6stmfmirror"
    canary = f"INJECTED {seed.stem} {variant} ALPHA"
    buf = bytearray(seed.data)
    prev = last_startxref(seed.data)
    n = seed.size
    size = n + 12
    objs = page_objects(n, canary, b"%d 0 R" % (n + 3))
    offs = add_objects(buf, objs)
    extra = b"/Encrypt " + HOSTILE + b" /Root %d 0 R /Prev %d" % (n, prev)
    add_classic_xref(buf, offs, extra, size)
    assert bytes(buf).startswith(seed.data), "not pure-append!"
    out = OUT / f"{seed.stem}__{variant}.pdf"
    out.write_bytes(bytes(buf))
    return out, [canary], seed.canaries
cases = []
for s in ["aes256_r6__plain.pdf", "rc4_128_r4__plain.pdf"]:
    p, inj, orig = build(s)
    cases.append({"file": str(p), "injected": inj, "original": orig, "seed": s})
    print("[ok]", p, len(p.read_bytes()), "bytes")
results = {}
for eng in EXTRACTORS:
    res, fail = run_batch(eng, [c["file"] for c in cases], 60)
    if res is None:
        print(eng, "BATCH-FAIL", fail)
        for c in cases:
            results[(c["file"], eng)] = {"status": "CRASH", "text": "", "error": str(fail)}
    else:
        for c in cases:
            results[(c["file"], eng)] = res[c["file"]]
        print(eng, "done")
orig_hits = inj_hits = 0
for c in cases:
    for eng in EXTRACTORS:
        r = results[(c["file"], eng)]
        txt = re.sub(r"\s+", "", r.get("text") or "")
        oh = any(re.sub(r"\s+", "", x) in txt for x in c["original"])
        ih = any(re.sub(r"\s+", "", x) in txt for x in c["injected"])
        orig_hits += bool(oh); inj_hits += bool(ih)
        print(f"{Path(c['file']).name} {eng}: status={r['status']} orig={oh} inj={ih} err={(r.get('error') or r.get('noise') or '')[:130]}")
print(f"ORIGINAL {orig_hits}/12 injected {inj_hits}/12")
json.dump({f"{k[0]}::{k[1]}": v for k, v in results.items()}, open(OUT/"results.json","w"), indent=1)
print("wrote", OUT/"results.json")
