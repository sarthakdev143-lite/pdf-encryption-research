[0m$ [0m.venv/bin/python - <<'EOF'
import re, pathlib
# Raw-byte audit: does any canary appear literally in encrypted file bytes?
files = sorted(pathlib.Path("corpus/writers").glob("*.pdf")) + sorted(pathlib.Path("corpus/base").glob("*.pdf"))
canary_re = re.compile(rb"CANARY")
leaks = []
for f in files:
    data = f.read_bytes()
    # determine expected canaries by context: writers use control_plain, base uses own stem
    hits = canary_re.findall(data)
    # check for literal "CANARY" in raw bytes of files that should be encrypted
    is_enc = f.name not in ("control_plain.pdf",) and "control_owner_only" not in f.name
    # control_owner_only has empty user pw -> readable without password by design; note separately
    if is_enc and f.name != "control_plain.pdf":
        # owner-only file: user password is empty so raw canary absence still expected? qpdf encrypts with empty user pw -> streams still encrypted
        if b"CANARY" in data:
            # could be filename/metadata? check context
            idx = data.find(b"CANARY")
            leaks.append((f.name, data[max(0,idx-40):idx+60]))
            print(f"LEAK-CANDIDATE {f.name}: ...{data[max(0,idx-40):idx+60]!r}...")
        else:
            print(f"ok-encrypted-no-plaintext {f.name}")
    else:
        print(f"control {f.name}: CANARY in raw = {b'CANARY' in data}")
print("leak candidates:", len(leaks))
EOF
