"""Cycle 30: Track 2 /Length-mismatch probe.

NEW variant t_encrypt_stdV4R4POULen40: cycle-11 shape
(/Filter/Standard /V 4 /R 4 /P -4 /O <32 zero bytes> /U <32 zero bytes>)
but /Length 40 instead of /Length 128. Direct-in-trailer dict, appended
revision with injected plaintext page. 2 seeds x 6 engines, no-password.
"""
import re, json, sys
from pathlib import Path

ROOT = Path("/home/sarthak/pdf-encryption-research")
sys.path.insert(0, str(ROOT))
from prevchain import Seed, page_objects, add_objects, add_classic_xref, last_startxref
from triage import EXTRACTORS, run_batch

OUTDIR = Path("/tmp/opencode/cycle30_len40")
OUTDIR.mkdir(parents=True, exist_ok=True)

SEEDS = ["aes256_r6__plain.pdf", "rc4_128_r4__plain.pdf"]
ZERO32 = "00" * 32
ENCRYPT = (
    f"<< /Filter /Standard /V 4 /R 4 /P -4 "
    f"/O <{ZERO32}> /U <{ZERO32}> /Length 40 >>"
).encode("latin-1")

results = {}
for name in SEEDS:
    seed = Seed(name)
    canary = f"INJECTED {seed.stem} t_len40 ALPHA"
    buf = bytearray(seed.data)
    orig_len = len(seed.data)
    prev = last_startxref(seed.data)
    n = seed.size
    objs = page_objects(n, canary, b"%d 0 R" % (n + 3))
    offs = add_objects(buf, objs)
    extra = (
        b"/Encrypt " + ENCRYPT + b" /Root %d 0 R /Prev %d" % (n, prev)
    )
    add_classic_xref(buf, offs, extra, n + 12)
    assert bytes(buf[:orig_len]) == seed.data, "not pure-append!"
    out = OUTDIR / f"{seed.stem}__t_len40.pdf"
    out.write_bytes(bytes(buf))
    results[name] = {
        "file": str(out),
        "injected": [canary],
        "original": seed.canaries,
        "pure_append": True,
    }
    print(f"[ok] {out.name} size={out.stat().st_size} orig={orig_len}")

paths = [v["file"] for v in results.values()]
allrows = []
for engine in EXTRACTORS:
    res, failure = run_batch(engine, paths, 300)
    for name, v in results.items():
        r = {"status": "CRASH", "text": "", "error": str(failure)} if res is None else res[v["file"]]
        text = r.get("text") or ""
        norm = re.sub(r"\s+", "", text)
        inj = any(re.sub(r"\s+", "", x) in norm for x in v["injected"])
        orig = any(re.sub(r"\s+", "", x) in norm for x in v["original"])
        row = {"seed": name, "engine": engine, "status": r["status"],
               "injected": inj, "original": orig,
               "detail": (r.get("error") or r.get("noise") or "")[:160]}
        allrows.append(row)
        print(f"{engine:10} {name:22} {r['status']:8} inj={int(inj)} orig={int(orig)} {row['detail'][:100]}")

(OUTDIR / "results.json").write_text(json.dumps(allrows, indent=1))
o = sum(1 for r in allrows if r["original"])
i = sum(1 for r in allrows if r["injected"])
print(f"\nORIGINAL shown: {o}/12, injected shown: {i}/12")
