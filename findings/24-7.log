"""Cycle 61 (Track 2): t_encrypt_stdV5permsGarbage.

Minimal delta vs cycle 33 (t_encrypt_stdV5R6zeroed): identical V5/R6 hostile
trailer dict but /Perms as a WRONG-TYPED literal paren string instead of
16-zero-byte hex. Completes the wrong-typed family: OE/UE (cycle 36), O/U
(cycle 37), Perms (this cycle).

Variant: appended plaintext page (n..n+3), classic trailer with direct-dict
/Encrypt + /Root n + /Prev orig. 2 seeds x 6 engines = 12 no-password probes.
"""
from __future__ import annotations

import json
import re
import sys
from pathlib import Path

ROOT = Path("/home/sarthak/pdf-encryption-research")
sys.path.insert(0, str(ROOT))

from prevchain import Seed, add_classic_xref, add_objects, page_objects  # noqa: E402
from triage import EXTRACTORS, run_batch  # noqa: E402

OUT = Path("/tmp/opencode/cycle61_permsgarbage")
OUT.mkdir(parents=True, exist_ok=True)
VARIANT = "t_encrypt_stdV5permsGarbage"
ZERO32 = "00" * 32
# wrong-typed Perms: literal paren string, 16 chars like the real Perms length
PERMS_GARBAGE = b"(GARBAGE-PERMS-12)"


def hostile_encrypt() -> bytes:
    return (
        b"/Encrypt << /Filter /Standard /V 5 /R 6 /Length 256 /P -4 "
        b"/O <%s> /U <%s> /OE <%s> /UE <%s> /Perms %s "
        b"/CF << /DefaultCryptFilter << /AuthEvent /DocOpen /CFM /AESV3 /Length 32 >> >> "
        b"/StmF /DefaultCryptFilter /StrF /DefaultCryptFilter >>"
        % (ZERO32.encode(), ZERO32.encode(), ZERO32.encode(), ZERO32.encode(), PERMS_GARBAGE)
    )


def build(seed: Seed) -> tuple[Path, list[str]]:
    canary = f"INJECTED {seed.stem} {VARIANT} ALPHA"
    buf = bytearray(seed.data)
    prev_match = list(re.finditer(rb"startxref\s+(\d+)\s+%%EOF", seed.data))
    prev = int(prev_match[-1].group(1))
    n = seed.size
    objs = page_objects(n, canary, b"%d 0 R" % (n + 3))
    offs = add_objects(buf, objs)
    add_classic_xref(
        buf, offs, hostile_encrypt() + b" /Root %d 0 R /Prev %d" % (n, prev), n + 12
    )
    out = OUT / f"{seed.stem}__{VARIANT}.pdf"
    out.write_bytes(bytes(buf))
    return out, [canary]


def main() -> None:
    cases = []
    for name in ("aes256_r6__plain.pdf", "rc4_128_r4__plain.pdf"):
        seed = Seed(name)
        path, injected = build(seed)
        # pure-append sanity: truncating at original EOF must still open with password
        import pikepdf

        trunc = OUT / (path.stem + ".trunc.pdf")
        trunc.write_bytes(path.read_bytes()[: len(seed.data)])
        with pikepdf.open(str(trunc), password="Us3r-Passw0rd!"):
            pass
        cases.append(
            {"file": str(path), "injected": injected, "original": seed.canaries,
             "seed": name}
        )
        print(f"[ok] {path.name}")
    rows = []
    for engine in EXTRACTORS:
        results, failure = run_batch(engine, [c["file"] for c in cases], 300)
        for c in cases:
            res = {"status": "CRASH", "text": "", "error": failure} if results is None else results[c["file"]]
            text = res.get("text") or ""
            norm = re.sub(r"\s+", "", text)
            rows.append(
                {"seed": c["seed"], "engine": engine, "status": res["status"],
                 "injected_shown": any(re.sub(r"\s+", "", x) in norm for x in c["injected"]),
                 "original_shown": any(re.sub(r"\s+", "", x) in norm for x in c["original"]),
                 "detail": (res.get("error") or res.get("noise") or "")[:200]}
            )
        print(f"{engine}: done")
    (OUT / "results.json").write_text(json.dumps(rows, indent=2))
    for r in rows:
        print(r["seed"], r["engine"], r["status"],
              "ORIGINAL" if r["original_shown"] else "orig-",
              "INJ" if r["injected_shown"] else "inj-", "|", r["detail"][:100])
    print("ORIGINAL_LEAKS:", sum(1 for r in rows if r["original_shown"]), "/12")


if __name__ == "__main__":
    main()
