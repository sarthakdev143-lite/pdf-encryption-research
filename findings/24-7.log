"""Cycle 1 (2026-10-30), Track 2 micro-step: trailer `/Encrypt <<>>` (empty dict).

Appended revision with a plaintext page; trailer carries a PRESENT-but-empty
/Encrypt dict (distinct from t_none=absent, t_encrypt_null=null 9999,
t_encrypt_dangling=dangling ref). 2 seeds x 6 engines = 12 no-password probes.
"""
import json
import re
import sys
from pathlib import Path

ROOT = Path("/home/sarthak/pdf-encryption-research")
sys.path.insert(0, str(ROOT))
from triage import EXTRACTORS, run_batch  # noqa: E402
from prevchain import (  # noqa: E402
    Seed,
    add_classic_xref,
    add_objects,
    last_startxref,
    page_objects,
)

OUT = Path("/tmp/opencode/cycle1_emptydict")
OUT.mkdir(parents=True, exist_ok=True)

SEEDS = ["aes256_r6__plain.pdf", "rc4_128_r4__plain.pdf"]
VARIANT = "t_encrypt_emptydict"

cases = []
for name in SEEDS:
    seed = Seed(name)
    canary = f"INJECTED {seed.stem} {VARIANT} ALPHA"
    buf = bytearray(seed.data)
    prev = last_startxref(seed.data)
    n = seed.size
    objs = page_objects(n, canary, b"%d 0 R" % (n + 3))
    offs = add_objects(buf, objs)
    extra = b"/Encrypt <<>> /Root %d 0 R /Prev %d" % (n, prev)
    add_classic_xref(buf, offs, extra, n + 12)
    out = OUT / f"{seed.stem}__{VARIANT}.pdf"
    out.write_bytes(bytes(buf))
    cases.append({"seed": name, "file": str(out),
                  "injected": [canary], "original": seed.canaries,
                  "encrypted": seed.encrypted})
    print(f"[ok] {out.name}")

rows = []
paths = [c["file"] for c in cases]
for engine in EXTRACTORS:
    results, failure = run_batch(engine, paths, 300)
    for c in cases:
        res = {"status": "CRASH", "text": "", "error": failure} if results is None \
            else results[c["file"]]
        text = res.get("text") or ""
        norm = re.sub(r"\s+", "", text)
        rows.append({
            "seed": c["seed"], "engine": engine, "status": res["status"],
            "injected_shown": any(re.sub(r"\s+", "", x) in norm for x in c["injected"]),
            "original_shown": any(re.sub(r"\s+", "", x) in norm for x in c["original"]),
            "detail": (res.get("error") or res.get("noise") or "")[:160],
        })
    print(f"{engine}: {len(cases)} files probed")

(OUT / "results.json").write_text(json.dumps(rows, indent=1))
orig = [r for r in rows if r["original_shown"]]
inj = [r for r in rows if r["injected_shown"]]
print(f"ORIGINAL shown: {len(orig)}/{len(rows)}  injected shown: {len(inj)}/{len(rows)}")
for r in rows:
    print(f"{r['seed'][:12]} {r['engine']:10} {r['status']:8} inj={int(r['injected_shown'])} ORIG={int(r['original_shown'])} {r['detail'][:80]}")
