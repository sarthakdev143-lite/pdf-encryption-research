"""Cycle 33: Track 2 V5-zeroed-OE/UE probe.

NEW variant t_encrypt_stdV5R6zeroed: appended revision with injected plaintext
page, hostile trailer /Encrypt as a DIRECT dict:
  << /Filter /Standard /V 5 /R 6 /Length 256 /P -4
     /O <32 zero bytes> /U <32 zero bytes>
     /OE <32 zero bytes> /UE <32 zero bytes> /Perms <16 zero bytes>
     /CF << /DefaultCryptFilter << /AuthEvent /DocOpen /CFM /AESV3 /Length 32 >> >>
     /StmF /DefaultCryptFilter /StrF /DefaultCryptFilter >>
Fresh axis (prior cycles exhausted O/U-length on V4/R4: 32 vs 8 vs 0 identical,
all unanimous-refuse). Tests whether any stack parses V5 fields (OE/UE) on a
zeroed dict and falls back to plaintext / divides by zero / treats as absent.
2 seeds x 6 engines, no-password. Not in prevchain VARIANTS.
"""
import re, json, sys
from pathlib import Path

ROOT = Path("/home/sarthak/pdf-encryption-research")
sys.path.insert(0, str(ROOT))
from prevchain import Seed, page_objects, add_objects, add_classic_xref, last_startxref
from triage import EXTRACTORS, run_batch

OUTDIR = Path("/tmp/opencode/cycle33_v5zeroed")
OUTDIR.mkdir(parents=True, exist_ok=True)

SEEDS = ["aes256_r6__plain.pdf", "rc4_128_r4__plain.pdf"]
O = "00" * 32
U = "00" * 32
OE = "00" * 32
UE = "00" * 32
PERMS = "00" * 16
ENCRYPT = (
    b"<< /Filter /Standard /V 5 /R 6 /Length 256 /P -4 "
    b"/O <%s> /U <%s> /OE <%s> /UE <%s> /Perms <%s> "
    b"/CF << /DefaultCryptFilter << /AuthEvent /DocOpen /CFM /AESV3 /Length 32 >> >> "
    b"/StmF /DefaultCryptFilter /StrF /DefaultCryptFilter >>"
    % (O.encode(), U.encode(), OE.encode(), UE.encode(), PERMS.encode())
)

results = {}
for name in SEEDS:
    seed = Seed(name)
    canary = f"INJECTED {seed.stem} t_v5zeroed ALPHA"
    buf = bytearray(seed.data)
    orig_len = len(seed.data)
    prev = last_startxref(seed.data)
    n = seed.size
    objs = page_objects(n, canary, b"%d 0 R" % (n + 3))
    offs = add_objects(buf, objs)
    extra = b"/Encrypt " + ENCRYPT + b" /Root %d 0 R /Prev %d" % (n, prev)
    add_classic_xref(buf, offs, extra, n + 12)
    assert bytes(buf[:orig_len]) == seed.data, "not pure-append!"
    out = OUTDIR / f"{seed.stem}__t_v5zeroed.pdf"
    out.write_bytes(bytes(buf))
    results[name] = {
        "file": str(out),
        "injected": [canary],
        "original": seed.canaries,
        "pure_append": True,
    }
    print(f"[ok] {out.name} size={out.stat().st_size} orig={orig_len}", flush=True)

paths = [v["file"] for v in results.values()]
allrows = []
for engine in EXTRACTORS:
    res, failure = run_batch(engine, paths, 300)
    for name, v in results.items():
        r = {"status": "CRASH", "text": "", "error": str(failure)} if res is None else res[v["file"]]
        text = r.get("text") or ""
        norm = re.sub(r"\s+", "", text)
        inj = any(re.sub(r"\s+", "", x) in norm for x in v["injected"])
        orig = any(re.sub(r"\s+", "", x) in norm for x in v["original"])
        row = {"seed": name, "engine": engine, "status": r["status"],
               "injected": inj, "original": orig,
               "detail": (r.get("error") or r.get("noise") or "")[:160]}
        allrows.append(row)
        print(f"{engine:10} {name:22} {r['status']:8} inj={int(inj)} orig={int(orig)} {row['detail'][:100]}", flush=True)

(OUTDIR / "results.json").write_text(json.dumps(allrows, indent=1))
o = sum(1 for r in allrows if r["original"])
i = sum(1 for r in allrows if r["injected"])
print(f"\nORIGINAL shown: {o}/12, injected shown: {i}/12")
