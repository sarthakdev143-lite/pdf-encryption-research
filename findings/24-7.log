===cycle38 builder head===
"""Cycle 38: t_encrypt_stdV5R6noperms - V5 hostile dict with /Perms REMOVED.
Minimal delta vs cycle 33 (zeroed V5): identical dict but /Perms absent, not
zeroed; O/U/OE/UE/CF kept zeroed-valid to isolate the Perms gate (cycle 34
removed OE/UE/Perms together). 2 seeds x 6 engines = 12 no-password probes."""
import re, json, sys
from pathlib import Path
import pikepdf
sys.path.insert(0, ".")
from triage import EXTRACTORS, run_batch

ROOT = Path(".").resolve()
BASE = ROOT / "corpus" / "base"
OUT = Path("/tmp/opencode/cycle38_v5noperms")
OUT.mkdir(parents=True, exist_ok=True)
USER_PW = "Us3r-Passw0rd!"

SEEDS = ["aes256_r6__plain.pdf", "rc4_128_r4__plain.pdf"]
GARB_O = b"(GARBAGE-O-1111111111111111111111)"
GARB_U = b"(GARBAGE-U-2222222222222222222222)"

def last_startxref(data: bytes) -> int:
    ms = list(re.finditer(rb"startxref\s+(\d+)\s+%%EOF", data))
    return int(ms[-1].group(1))

def build(seed_name, variant):
    data = (BASE / seed_name).read_bytes()
    stem = Path(seed_name).stem
    with pikepdf.open(str(BASE / seed_name), password=USER_PW) as pdf:
        size = max(int(x) for x in re.findall(rb"/Size\s+(\d+)", data))
        root = pdf.Root.objgen[0]
    canary = f"INJECTED {stem} {variant} ALPHA"
    orig = [f"CANARY {stem} ALPHA", f"CANARY {stem} BRAVO"]
    buf = bytearray(data)
    prev = last_startxref(data)
    n = size
    newsize = n + 12
    content = f"BT /F1 12 Tf 72 700 Td ({canary}) Tj ET".encode("latin-1")
    objs = {
        n: b"<< /Type /Catalog /Pages %d 0 R >>" % (n+1),
        n+1: b"<< /Type /Pages /Kids [%d 0 R] /Count 1 >>" % (n+2),
        n+2: (b"<< /Type /Page /Parent %d 0 R /MediaBox [0 0 612 792] "
               b"/Resources << /Font << /F1 << /Type /Font /Subtype /Type1 "
               b"/BaseFont /Helvetica >> >> >> /Contents %d 0 R >>") % (n+1, n+3),
        n+3: b"<< /Length %d >>\nstream\n" % len(content) + content + b"\nendstream",
    }
    if not buf.endswith(b"\n"):
        buf += b"\n"
    offs = {}
    for num in sorted(objs):
        offs[num] = len(buf)
        buf += b"%d 0 obj\n" % num + objs[num] + b"\nendobj\n"
    oe = b"<" + b"00"*32 + b">"
    ou = b"<" + b"00"*32 + b">"
    enc = (b"<< /Filter /Standard /V 5 /R 6 /Length 256 /P -4 "
           b"/O " + ou + b" /U " + ou +
           b" /OE " + oe + b" /UE " + oe +
           b" /CF <</DefaultCryptFilter <</AuthEvent /DocOpen /CFM /AESV3 /Length 32>>>> "
           b"/StmF /DefaultCryptFilter /StrF /DefaultCryptFilter >>")
    xref_off = len(buf)
    nums = sorted(offs)
    buf += b"xref\n0 1\n0000000000 65535 f \n"
    buf += b"%d %d\n" % (nums[0], len(nums))
    for num in nums:
        buf += b"%010d 00000 n \n" % offs[num]
    buf += (b"trailer\n<< /Size %d /Encrypt " % newsize + enc +
            b" /Root %d 0 R /Prev %d >>\n" % (n, prev))
    buf += b"startxref\n%d\n%%%%EOF\n" % xref_off
    # pure-append check
    assert bytes(buf[:len(data)]) == data, "not a pure append!"
    out = OUT / f"{stem}__{variant}.pdf"
    out.write_bytes(bytes(buf))
    return str(out), canary, orig

variant = "t_encrypt_stdV5R6noperms"
cases = []
for s in SEEDS:
    p, inj, orig = build(s, variant)
    cases.append({"seed": s, "file": p, "injected": [inj], "original": orig})
    print("built", p)

paths = [c["file"] for c in cases]
rows = []
for eng in EXTRACTORS:
    res, fail = run_batch(eng, paths, 300)
    for c in cases:
        r = {"status": "CRASH", "text": "", "error": fail} if res is None else res[c["file"]]
        t = r.get("text") or ""
        norm = re.sub(r"\s+", "", t)
        inj_hit = any(re.sub(r"\s+", "", x) in norm for x in c["injected"])
        org_hit = any(re.sub(r"\s+", "", x) in norm for x in c["original"])
        detail = (r.get("error") or r.get("noise") or "")[:200]
        rows.append({"seed": c["seed"], "engine": eng, "status": r["status"],
