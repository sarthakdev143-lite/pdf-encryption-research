"""Cycle 57: t_encrypt_stdV5noP — cycle-33 V5/R6 hostile dict with /P removed."""
import json, re, sys
from pathlib import Path
sys.path.insert(0, "/home/sarthak/pdf-encryption-research")
from triage import EXTRACTORS, run_batch
import pikepdf

ROOT = Path("/home/sarthak/pdf-encryption-research")
BASE = ROOT / "corpus" / "base"
OUT = Path("/tmp/opencode/cycle57_pabsent")
OUT.mkdir(parents=True, exist_ok=True)
USER_PW = "Us3r-Passw0rd!"
VARIANT = "t_encrypt_stdV5noP"
SEEDS = ["aes256_r6__plain.pdf", "rc4_128_r4__plain.pdf"]

Z32 = "00" * 32
Z16 = "00" * 16
# Cycle-33 dict MINUS /P (P-absent axis; everything else zeroed-valid)
ENCRYPT_DIRECT = (
    "<< /Filter /Standard /V 5 /R 6 /Length 256"
    f" /O <{Z32}> /U <{Z32}> /OE <{Z32}> /UE <{Z32}> /Perms <{Z16}>"
    " /CF << /DefaultCryptFilter << /AuthEvent /DocOpen /CFM /AESV3 /Length 32 >> >>"
    " /StmF /DefaultCryptFilter /StrF /DefaultCryptFilter >>"
).encode("latin-1")

def last_startxref(data):
    ms = list(re.finditer(rb"startxref\s+(\d+)\s+%%EOF", data))
    return int(ms[-1].group(1))

def build(seed_name):
    data = (BASE / seed_name).read_bytes()
    stem = seed_name.replace(".pdf", "")
    with pikepdf.open(str(BASE / seed_name), password=USER_PW) as pdf:
        size = max(int(x) for x in re.findall(rb"/Size\s+(\d+)", data))
    canary = f"INJECTED {stem} {VARIANT} ALPHA"
    orig = [f"CANARY {stem} ALPHA", f"CANARY {stem} BRAVO"]
    buf = bytearray(data)
    prev = last_startxref(data)
    n = size
    content = f"BT /F1 12 Tf 72 700 Td ({canary}) Tj ET".encode("latin-1")
    objs = {
        n: b"<< /Type /Catalog /Pages %d 0 R >>" % (n + 1),
        n + 1: b"<< /Type /Pages /Kids [%d 0 R] /Count 1 >>" % (n + 2),
        n + 2: (b"<< /Type /Page /Parent %d 0 R /MediaBox [0 0 612 792] "
                 b"/Resources << /Font << /F1 << /Type /Font /Subtype /Type1 "
                 b"/BaseFont /Helvetica >> >> >> /Contents %d 0 R >>" % (n + 1, n + 3)),
        n + 3: b"<< /Length %d >>\nstream\n" % len(content) + content + b"\nendstream",
    }
    if not buf.endswith(b"\n"):
        buf += b"\n"
    offs = {}
    for num in sorted(objs):
        offs[num] = len(buf)
        buf += b"%d 0 obj\n" % num + objs[num] + b"\nendobj\n"
    xref_off = len(buf)
    nums = sorted(offs)
    buf += b"xref\n0 1\n0000000000 65535 f \n"
    buf += b"%d %d\n" % (nums[0], len(nums))
    for num in nums:
        buf += b"%010d 00000 n \n" % offs[num]
    buf += (b"trailer\n<< /Size %d /Encrypt " % (n + 12) + ENCRYPT_DIRECT +
            b" /Root %d 0 R /Prev %d >>\n" % (n, prev))
    buf += b"startxref\n%d\n%%%%EOF\n" % xref_off
    p = OUT / f"{stem}__{VARIANT}.pdf"
    p.write_bytes(bytes(buf))
    return str(p), [canary], orig

cases = [build(s) for s in SEEDS]
paths = [c[0] for c in cases]
results = {}
for eng in EXTRACTORS:
    res, fail = run_batch(eng, paths, 300)
    results[eng] = (res, fail)
    print(f"{eng}: {'BATCH-FAIL '+str(fail) if res is None else 'ok'}")

out = []
for i, p in enumerate(paths):
    inj, orig = cases[i][1], cases[i][2]
    for eng in EXTRACTORS:
        res, fail = results[eng]
        r = dict(fail) if res is None else res[p]
        text = r.get("text") or ""
        norm = re.sub(r"\s+", "", text)
        ih = any(re.sub(r"\s+", "", x) in norm for x in inj)
        oh = any(re.sub(r"\s+", "", x) in norm for x in orig)
        out.append({"file": Path(p).name, "engine": eng, "status": r.get("status"),
                    "injected": ih, "original": oh,
                    "detail": (r.get("error") or r.get("noise") or f"text_len={r.get('text_len',0)}")[:300]})
        print(f"{Path(p).name} {eng}: status={r.get('status')} injected={ih} original={oh} detail={(r.get('error') or r.get('noise') or '')[:150]}")
(OUT / "results.json").write_text(json.dumps(out, indent=1))
print("ORIGINAL hits:", sum(1 for r in out if r["original"]), "INJECTED hits:", sum(1 for r in out if r["injected"]))
