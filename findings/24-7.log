"""Cycle 54: t_encrypt_stdV5nor — cycle-33 V5/R6 hostile dict with /R 6 REMOVED (R-presence axis)."""
import json, re, sys
sys.path.insert(0, "/home/sarthak/pdf-encryption-research")
from pathlib import Path
from prevchain import Seed, page_objects, add_objects, add_classic_xref, last_startxref

ROOT = Path("/home/sarthak/pdf-encryption-research")
OUTDIR = Path("/tmp/opencode/cycle54_rabsent")
OUTDIR.mkdir(parents=True, exist_ok=True)

ZERO32 = "00" * 32
ZERO16 = "00" * 16
ENCRYPT_NOR = (
    "<< /Filter /Standard /V 5 /Length 256 /P -4 "
    f"/O <{ZERO32}> /U <{ZERO32}> /OE <{ZERO32}> /UE <{ZERO32}> /Perms <{ZERO16}> "
    "/CF <</DefaultCryptFilter <</AuthEvent /DocOpen /CFM /AESV3 /Length 32>>>> "
    "/StmF /DefaultCryptFilter /StrF /DefaultCryptFilter >>"
).encode("latin-1")

def build(seed_name):
    seed = Seed(seed_name)
    canary = f"INJECTED {seed.stem} t_encrypt_stdV5nor ALPHA"
    buf = bytearray(seed.data)
    prev = last_startxref(seed.data)
    n = seed.size
    size = n + 12
    objs = page_objects(n, canary, b"%d 0 R" % (n + 3))
    offs = add_objects(buf, objs)
    extra = b"/Encrypt " + ENCRYPT_NOR + b" /Root %d 0 R /Prev %d" % (n, prev)
    add_classic_xref(buf, offs, extra, size)
    out = OUTDIR / f"{seed.stem}__t_encrypt_stdV5nor.pdf"
    out.write_bytes(bytes(buf))
    assert bytes(buf)[:len(seed.data)] == seed.data, "not pure append"
    return out, seed, canary

files, meta = [], {}
for s in ["aes256_r6__plain.pdf", "rc4_128_r4__plain.pdf"]:
    p, seed, canary = build(s)
    files.append(str(p))
    meta[str(p)] = {"seed": s, "injected": canary, "original": seed.canaries}
    print(f"[ok] {p.name} size={p.stat().st_size}", flush=True)

from triage import EXTRACTORS, run_batch
rows = []
for engine in EXTRACTORS:
    results, failure = run_batch(engine, files, 300)
    for f in files:
        res = {"status": "CRASH", "text": "", "error": str(failure)} if results is None else results[f]
        text = res.get("text") or ""
        norm = re.sub(r"\s+", "", text)
        m = meta[f]
        inj = re.sub(r"\s+", "", m["injected"]) in norm
        orig = any(re.sub(r"\s+", "", x) in norm for x in m["original"])
        rows.append({"file": Path(f).name, "engine": engine, "status": res["status"],
                     "injected": inj, "original": orig,
                     "detail": (res.get("error") or res.get("noise") or "")[:200]})
        print(f"{engine} {Path(f).name}: {res['status']} inj={inj} orig={orig} :: {(res.get('error') or '')[:160]}", flush=True)

(OUTDIR / "results.json").write_text(json.dumps(rows, indent=1))
orig_hits = sum(1 for r in rows if r["original"])
inj_hits = sum(1 for r in rows if r["injected"])
print(f"ORIGINAL {orig_hits}/{len(rows)} injected {inj_hits}/{len(rows)}")
