from __future__ import annotations

import csv
import json
import re
from pathlib import Path

import pikepdf

from triage import EXTRACTORS, run_batch

ROOT = Path(__file__).resolve().parent
BASE = ROOT / "corpus" / "base"
OUT = ROOT / "corpus" / "prevchain"
FINDINGS = ROOT / "findings"

